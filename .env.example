# Keep false for local fallback content. When true, every CMS error is fatal.
GOOGLE_SHEETS_CMS_ENABLED=false

# Private Google Sheet and Viewer-only service-account credentials.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
# Vercel accepts the JSON private key with literal \n characters.
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional. Defaults to 1 and must equal Control.schema_version.
GOOGLE_SHEETS_EXPECTED_SCHEMA_VERSION=1

# Used for canonical sitemap and robots URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
